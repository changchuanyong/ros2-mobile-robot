<robot xmlns:xacro="http://wiki.ros.org/xacro">
    <xacro:include filename="$(find robot)/urdf/common_inertia.xacro" />
    <!-- PI 值 -->
    <xacro:property name="PI" value="3.1416"/>
    <!-- 定义车辆参数 -->
    <!-- 车体长宽高 -->
    <xacro:property name="base_link_x" value="0.45"/>
    <xacro:property name="base_link_y" value="0.30"/>
    <xacro:property name="base_link_z" value="0.16"/>
    <!-- 离地间距 -->
    <xacro:property name="distance" value="0.04"/>
    <!-- 车轮半径 宽度 -->
    <xacro:property name="wheel_radius" value="0.065"/>
    <xacro:property name="wheel_length" value="0.035"/>

    <!-- 定义颜色 -->
    <material name="yellow">
        <color rgba="0.7 0.7 0 0.8" />
    </material>
    <material name="red">
        <color rgba="0.8 0.1 0.1 0.8" />
    </material>
    <material name="gray">
        <color rgba="0.2 0.2 0.2 0.95" />
      </material>
    <!-- 定义 base_footprint -->
    <link name="base_footprint">
        <visual>
            <geometry>
                <sphere radius="0.001"/>
            </geometry>
        </visual>
    </link>

    <!-- 定义 base_link -->
    <link name="base_link">
        <visual>
            <!-- 形状 -->
            <geometry>
                <box size="${base_link_x} ${base_link_y} ${base_link_z}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="yellow"/>
        </visual>
        <collision>
            <!-- 形状 -->
            <geometry>
                <box size="${base_link_x} ${base_link_y} ${base_link_z}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="yellow"/>
        </collision>
        <xacro:box_inertia m="5.0" w="${base_link_x}" d="${base_link_y}" h="${base_link_z}"/>
    </link>
    <joint name="baselink2basefootprint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 ${distance + base_link_z / 2}"/>
    </joint>
    <!-- 车轮宏定义 -->
    <xacro:macro name="wheel_func" params="wheel_name is_front is_left" >
        <link name="${wheel_name}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${PI / 2} 0 0" />
                <material name="gray"/>
            </visual>
            <collision>
                 <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${PI / 2} 0 0" />
                <material name="gray"/>
            </collision>
            <xacro:cylinder_inertia m="0.15" r="${wheel_radius}" h="${wheel_length}"/>
        </link>
        <joint name="${wheel_name}_wheel_joint" type="continuous">
            <parent link="base_link"  />
            <child link="${wheel_name}_wheel" />
            <origin xyz="${(base_link_x / 2 - wheel_radius) * is_front} ${base_link_y / 2 * is_left} ${(base_link_z / 2 + distance - wheel_radius) * -1}" rpy="0 0 0" />
            <axis xyz="0 1 0" />
            <dynamics damping="0.08" friction="0.01" />
        </joint>
    </xacro:macro>
    <xacro:macro name="wheel_friction" params="wheel_name">
        <gazebo reference="${wheel_name}_wheel">
            <mu1>1.0</mu1>
            <mu2>0.25</mu2>
            <kp>1000000.0</kp>
            <kd>10.0</kd>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="caster_func" params="caster_name is_front">
        <link name="${caster_name}_caster">
            <visual>
                <geometry>
                    <sphere radius="0.035" />
                </geometry>
                <material name="gray" />
            </visual>
            <collision>
                <geometry>
                    <sphere radius="0.035" />
                </geometry>
            </collision>
            <xacro:sphere_inertia m="0.05" r="0.035" />
        </link>
        <joint name="${caster_name}_caster_joint" type="fixed">
            <parent link="base_link" />
            <child link="${caster_name}_caster" />
            <origin xyz="${(base_link_x / 2 - 0.08) * is_front} 0 ${(base_link_z / 2 + distance - 0.035) * -1}" rpy="0 0 0" />
        </joint>
        <gazebo reference="${caster_name}_caster">
            <mu1>0.05</mu1>
            <mu2>0.05</mu2>
            <kp>1000000.0</kp>
            <kd>10.0</kd>
        </gazebo>
    </xacro:macro>

    <!-- Two centered drive wheels plus low-friction front/rear supports. -->
    <xacro:wheel_func wheel_name="left_front" is_front="0" is_left="1" />
    <xacro:wheel_func wheel_name="right_front" is_front="0" is_left="-1" />
    <xacro:wheel_friction wheel_name="left_front" />
    <xacro:wheel_friction wheel_name="right_front" />
    <xacro:caster_func caster_name="front" is_front="1" />
    <xacro:caster_func caster_name="rear" is_front="-1" />
</robot>
