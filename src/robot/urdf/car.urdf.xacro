<robot name="car" xmlns:xacro="http://wiki.ros.org/xacro">
    <xacro:include filename="car_base.urdf.xacro"/>
    <xacro:include filename="car_camera.urdf.xacro"/>
    <xacro:include filename="car_laser.urdf.xacro"/>

    <!-- 运动控制插件 -->
    <gazebo>
        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
            <left_joint>left_front_wheel_joint</left_joint>
            <right_joint>right_front_wheel_joint</right_joint>
            <wheel_separation>0.30</wheel_separation>
            <wheel_radius>0.065</wheel_radius>
            <odom_publish_frequency>50</odom_publish_frequency>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <publish_wheel_tf>true</publish_wheel_tf>
            <max_linear_acceleration>0.35</max_linear_acceleration>
            <min_linear_acceleration>-0.35</min_linear_acceleration>
            <max_angular_acceleration>0.8</max_angular_acceleration>
            <min_angular_acceleration>-0.8</min_angular_acceleration>
            <max_linear_velocity>0.35</max_linear_velocity>
            <min_linear_velocity>-0.35</min_linear_velocity>
            <max_angular_velocity>0.8</max_angular_velocity>
            <min_angular_velocity>-0.8</min_angular_velocity>
        </plugin>
    </gazebo>

    
    <!-- 关节状态发布 -->
    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        </plugin>
    </gazebo>

</robot>


