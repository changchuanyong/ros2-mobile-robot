<sdf version='1.10'>
  <world name='empty'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.56e-06 2.29e-05 -4.24e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.74 0.76 1</background>
      <shadows>true</shadows>
    </scene>

    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box><size>12 8 0.02</size></box>
          </geometry>
          <pose>0 0 -0.01 0 0 0</pose>
          <surface>
            <friction>
              <ode><mu>50</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <box><size>12 8 0.02</size></box>
          </geometry>
          <pose>0 0 -0.01 0 0 0</pose>
          <material>
            <ambient>0.78 0.80 0.78 1</ambient>
            <diffuse>0.78 0.80 0.78 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name='wall_east'>
      <static>true</static>
      <pose>6 0 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>0.12 8 1.0</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>0.12 8 1.0</size></box></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material></visual>
      </link>
    </model>

    <model name='wall_west'>
      <static>true</static>
      <pose>-6 0 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>0.12 8 1.0</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>0.12 8 1.0</size></box></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material></visual>
      </link>
    </model>

    <model name='wall_north'>
      <static>true</static>
      <pose>0 4 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>12 0.12 1.0</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>12 0.12 1.0</size></box></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material></visual>
      </link>
    </model>

    <model name='wall_south'>
      <static>true</static>
      <pose>0 -4 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>12 0.12 1.0</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>12 0.12 1.0</size></box></geometry><material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material></visual>
      </link>
    </model>

    <model name='obstacle_block_1'>
      <static>true</static>
      <pose>-2.2 1.4 0.35 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>0.7 0.7 0.7</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>0.7 0.7 0.7</size></box></geometry><material><ambient>0.65 0.36 0.26 1</ambient><diffuse>0.72 0.42 0.30 1</diffuse></material></visual>
      </link>
    </model>

    <model name='obstacle_block_2'>
      <static>true</static>
      <pose>1.2 -1.25 0.35 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>0.65 0.65 0.7</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>0.65 0.65 0.7</size></box></geometry><material><ambient>0.28 0.48 0.62 1</ambient><diffuse>0.33 0.56 0.72 1</diffuse></material></visual>
      </link>
    </model>

    <model name='obstacle_column'>
      <static>true</static>
      <pose>3.4 1.55 0.45 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><cylinder><radius>0.38</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name='visual'><geometry><cylinder><radius>0.38</radius><length>0.9</length></cylinder></geometry><material><ambient>0.38 0.50 0.34 1</ambient><diffuse>0.45 0.60 0.40 1</diffuse></material></visual>
      </link>
    </model>

    <model name='short_partition'>
      <static>true</static>
      <pose>-0.6 2.75 0.4 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>2.2 0.18 0.8</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>2.2 0.18 0.8</size></box></geometry><material><ambient>0.50 0.50 0.52 1</ambient><diffuse>0.58 0.58 0.60 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
